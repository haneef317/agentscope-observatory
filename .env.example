# AgentScope Observatory — environment configuration
# Copy this file to `.env` and adjust values for your environment.

# ------------------------------------------------- LLM (optional)
# Set OPENAI_API_KEY to run the agent against a real OpenAI-compatible LLM.
# Without it the platform runs in SIMULATOR mode (fully demoable, no cost).
OPENAI_API_KEY=
# OPENAI_API_BASE=https://your-openai-compatible-proxy.example.com/v1
DEFAULT_MODEL=gpt-4o-mini

# --------------------------------------------- PostgreSQL (docker defaults)
DATABASE_URL=postgresql+psycopg://agentscope:agentscope@localhost:5432/agentscope
DB_POOL_MIN=2
DB_POOL_MAX=10

# ----------------------------------------------- Redis (docker defaults)
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------- API / runtime
DEBUG=false
API_PREFIX=/api
FRONTEND_DIR=frontend/dist
